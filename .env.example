# Copy to .env.local and fill in the values. Shell variables win over this file.
#
# The extension only needs public values. Never put a service-role key or an
# OAuth client secret here: public OAuth clients have no secret, and a
# service-role key would give anyone who installs the build full database
# access.

# The Supabase project shared by the website and the extension.
NOBADFONTS_SUPABASE_URL=

# Public anon key. Safe to ship: Row Level Security decides what it can read.
NOBADFONTS_SUPABASE_ANON_KEY=

# Public OAuth client id from Supabase Dashboard > Authentication > OAuth Apps.
# Paste the same UUID into the website's NOBADFONTS_OAUTH_CLIENT_ID.
NOBADFONTS_OAUTH_CLIENT_ID=

# Optional: exact store listing review pages. Until they exist, the rating
# prompt opens each store's search page.
# NOBADFONTS_CHROME_REVIEW_URL=
# NOBADFONTS_EDGE_REVIEW_URL=
# NOBADFONTS_FIREFOX_REVIEW_URL=
